# ---- LLM (pick ONE provider) -------------------------------------------
# gemini | openai | anthropic | groq | openrouter | ollama
LLM_PROVIDER=gemini
# Your key for that provider (never commit .env)
LLM_API_KEY=
# Optional: override the default model for the provider
#   gemini -> gemini-2.5-flash      openai -> gpt-4.1-mini     anthropic -> claude-sonnet-4-5
#   groq   -> llama-3.3-70b-versatile   openrouter -> google/gemini-2.5-flash
LLM_MODEL=
# Free tiers have low requests-per-minute limits. Seconds to wait between LLM calls (e.g. 5 on a free tier).
LLM_MIN_INTERVAL=0
# Optional, for "thinking" models on OpenAI-compatible APIs: low | medium | high (low = faster/cheaper)
LLM_REASONING_EFFORT=
# Optional: other models to switch to when a free tier's DAILY limit is hit (comma separated)
LLM_FALLBACK_MODELS=
# Optional: stay under a tokens-per-minute limit (e.g. 7500 for Groq's free tier). 0 = off
LLM_TPM_LIMIT=0
# Optional: cap output tokens per call (e.g. 1500). 0 = provider default
LLM_MAX_OUTPUT_TOKENS=0
# Optional: OpenAI-compatible endpoint override (e.g. https://api.mistral.ai/v1 with LLM_PROVIDER=openai)
LLM_BASE_URL=

# ---- Agent -------------------------------------------------------------
AGENT_MAX_STEPS=120
BROWSER_HEADED=false
BROWSER_SLOW_MO=0

# ---- Sandbox company systems --------------------------------------------
# Credentials of the fake HireDesk app. The agent fills these via fill_secret and never sees them.
ATS_USERNAME=recruiter
ATS_PASSWORD=Hire@2026
# 1 = inject realistic failures (session expiry, 503 outage, booking race). 0 = off.
SANDBOX_CHAOS=1
# Pin "today" for reproducible runs (YYYY-MM-DD). Leave empty to use the real date.
SANDBOX_TODAY=
